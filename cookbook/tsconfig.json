      "@deltakit/aion/pipeline": ["../packages/aion/src/pipeline/index.ts"],
      "@deltakit/aion/providers": ["../packages/aion/src/providers/index.ts"],
      "@deltakit/aion/skills": ["../packages/aion/src/skills/index.ts"],
      "@deltakit/aion/tool": ["../packages/aion/src/tool/index.ts"],
